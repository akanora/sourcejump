{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.style, s.bonus, round(s.points)::int8 AS \"points!\",\n               1 + (SELECT count(*) FROM standings o\n                    WHERE o.style = s.style AND o.bonus = s.bonus AND o.points > s.points) AS \"rank!\"\n        FROM standings s\n        WHERE s.player_steamid64 = $1 AND s.points > 0\n        ",
