  "query": "\n        SELECT z.version, z.zones AS \"zones: JsonColumn<Vec<Zone>>\"\n        FROM map_zones z JOIN maps m ON m.id = z.map_id\n        WHERE m.name = $1\n        ORDER BY z.version DESC\n        LIMIT 1\n        ",
